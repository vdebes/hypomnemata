# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches and coverage data
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Local configuration (paths to your own journal, model choices)
config.local.toml
models.local.toml

# Runtime data (audit logs): kept next to the code, never versioned
var/

# Embedding vectors: regenerated by a command, never versioned
*.npy

# Test sets built from a personal journal must never be committed
testsets/
